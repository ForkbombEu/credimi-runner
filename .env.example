# Minimal environment for `credimi-runner serve`.
# Supply one credential, not both.
CREDIMI_URL=https://credimi.io
# CREDIMI_USER_API_KEY=
CREDIMI_INTERNAL_ADMIN_KEY=

CREDIMI_RUNNER_ID=org/runner

# At least one indexed device is required. Add further contiguous blocks for
# CREDIMI_DEVICE_2_*, CREDIMI_DEVICE_3_*, and so on when needed.
CREDIMI_DEVICE_COUNT=1
CREDIMI_DEVICE_1_ID=org/runner/device

# CREDIMI_DEVICE_1_ENABLED=true
# Device name, type, mode, serial, and local runtime settings are dashboard
# setup metadata. They are not required by `credimi-runner serve`.
